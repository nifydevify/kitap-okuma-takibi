# Firebase web app config (Firebase Console → Project settings → General → Your apps → SDK setup and configuration).
# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri gir. .env.local git'e eklenmez.
# Bu değerler boş bırakılırsa Google ile giriş / bulut senkronizasyonu tamamen devre dışı kalır,
# uygulama normal şekilde sadece cihazda (offline) çalışmaya devam eder.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
